# Copy this file to ".env" (same folder) and fill in YOUR values.
# Never share the .env file or commit it to GitHub.

# --- Database (Neon) ---------------------------------------------------------
# Neon dashboard > your project > Connect > copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# --- Sign-in -----------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Your own Google email address. This account becomes the Author. Separate several with commas.
AUTHOR_EMAILS=you@gmail.com
# A long random secret used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- File storage for retained .docx / .pdf uploads --------------------------
# "local" = saves files in backend/uploads (fine on your own computer).
# "s3"    = any S3-compatible private bucket, e.g. Cloudflare R2 (use this when deployed).
STORAGE_PROVIDER=local
# Only needed when STORAGE_PROVIDER=s3:
S3_BUCKET=
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Server ------------------------------------------------------------------
PORT=4000
# Largest .docx/.pdf you can upload, in megabytes.
MAX_UPLOAD_MB=10

# Only if the website and the API are on DIFFERENT web addresses (not needed for the
# default single-service deployment described in the README):
# APP_ORIGIN=https://your-site.example.com
# CROSS_SITE_COOKIES=true
